# ─────────────────────────────────────────────────────────────
#  AiNotetaker configuration.  Copy this file to ".env" and edit.
#      cp .env.example .env
#  Every value has a sensible default; you only NEED the API key.
# ─────────────────────────────────────────────────────────────

# ── OpenRouter (speech-to-text + AI analysis) ───────────────
# Get a key at https://openrouter.ai/keys  (starts with "sk-or-...")
OPENROUTER_API_KEY=

# Model that transcribes audio. Must accept audio input. Google's Gemini
# Flash models are cheap, fast and strong across a wide range of languages.
# Alternatives: google/gemini-2.5-flash (older, cheaper), google/gemini-2.5-pro,
# openai/gpt-4o-audio-preview
OPENROUTER_MODEL=google/gemini-3.8-flash

# Model that writes summaries, action items and reports (text only —
# audio is never sent here). Any strong chat model works.
OPENROUTER_TEXT_MODEL=google/gemini-3.8-flash

# Spoken-language hint as an ISO 639-1 code ("en", "es", "fr", "de", "fa",
# "hi", "ja", ...). Leave it EMPTY (the default) to auto-detect the language
# and follow a speaker who switches language mid-recording.
TRANSCRIBE_LANGUAGE=

# Optional comma-separated spellings the model should recognize exactly:
# people, clients, companies, products, acronyms, and code-switched terms.
# Hints are used only when the audio supports them.
TRANSCRIBE_VOCABULARY=

# Language for summaries/reports: "auto" (default) answers in whatever
# language the content is in. Force one with an ISO 639-1 code if you prefer.
ANALYSIS_LANGUAGE=auto

# Long recordings are transcribed in chunks (OpenRouter takes audio inline,
# ~20 MB per request). 600 s of 16 kHz mono FLAC ≈ 7 MB. Leave as is.
TRANSCRIBE_CHUNK_SECONDS=600
TRANSCRIBE_AUDIO_FORMAT=flac

# Transcription backend: "openrouter" (default), "azure-mai", or "openai".
TRANSCRIBE_PROVIDER=openrouter
# Optional provider used only if the primary provider fails. A safe migration
# to Microsoft is: TRANSCRIBE_PROVIDER=azure-mai and fallback=openrouter.
TRANSCRIBE_FALLBACK_PROVIDER=

# Microsoft MAI-Transcribe-2 (optional; currently an Azure public preview).
# Create an Azure Speech resource, then paste its endpoint and key here.
# Leave the locale empty for automatic language detection and code switching.
# AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_MODEL=MAI-Transcribe-2
# AZURE_SPEECH_LOCALE=
# AZURE_SPEECH_DIARIZATION=1
# AZURE_TRANSCRIBE_CHUNK_SECONDS=3600

# Any OpenAI-compatible /audio/transcriptions endpoint (OpenAI Whisper, Groq).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1    # or https://api.groq.com/openai/v1
# OPENAI_MODEL=whisper-1                        # or whisper-large-v3 (Groq)

# ── Noise removal ────────────────────────────────────────────
# auto (default) = DeepFilterNet binary if installed, else noisereduce.
# Install the binary with:  ./scripts/install-deepfilter.sh   (recommended)
# Options: auto | deepfilter-bin | deepfilternet | noisereduce | off
# The original recording is always kept; a cleaned copy is stored alongside.
DENOISE_ENGINE=auto

# Path to the deep-filter binary. Leave empty to search PATH and ~/.local/bin.
DEEPFILTER_BIN=

# Optional maximum suppression for unusually noisy recordings. DeepFilterNet
# warns that this may over-attenuate very noisy speech, so natural mode is the
# safe default. Set to 1 only when the normal cleaned copy is not quiet enough.
DEEPFILTER_POSTFILTER=0

# How strongly the lightweight denoiser (noisereduce) attenuates noise, 0.0–1.0.
# Lower = more natural sound, higher = quieter background. DeepFilterNet ignores this.
DENOISE_STRENGTH=0.8

# ── Security ─────────────────────────────────────────────────
# Password for the web app. Strongly recommended if the server is reachable
# from anywhere other than your own machine / private Tailscale network.
APP_PASSWORD=

# Bearer token for the iOS app (paste the same value into the app's
# Settings). Generate one with:  openssl rand -hex 24
# Either secret works in either place; one value is enough.
API_TOKEN=

# Secret used to sign login cookies. Leave blank to auto-generate and
# persist one in data/.secret_key (recommended).
SECRET_KEY=

# ── Server ───────────────────────────────────────────────────
# 0.0.0.0 supports direct LAN access. The recommended
# scripts/setup-remote-access.sh changes this to 127.0.0.1 so only the private
# Tailscale HTTPS proxy can reach the server from another device.
HOST=0.0.0.0
PORT=8000

# The address the iPhone app should save for reaching this Mac from anywhere.
# Leave it empty and the server finds it itself: Tailscale Serve's HTTPS
# *.ts.net name, else the plain MagicDNS name. Set it only when you front
# AiNotetaker with your own domain or reverse proxy, e.g.
#   PUBLIC_URL=https://notes.example.com
# It is reported to authenticated clients only, never published anywhere.
PUBLIC_URL=

# Largest recording upload accepted (MB). Lossless 48 kHz mono ≈ 170 MB/hour.
MAX_UPLOAD_MB=2048

# Display name shown in the app header and on the iPhone home screen.
APP_TITLE=Notes

# Where the SQLite database, recordings and secrets are stored.
DATA_DIR=data
